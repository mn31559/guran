<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>القرآن الكريم - سعود الشريم</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@400;600;700&display=swap"
rel="stylesheet">

<style>

/* =========================
   الصفحة والخلفية
========================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    color: #173b2b;

    font-family: "Cairo", Arial, sans-serif;

    background-color: #064d35;

    /*
       زخرفة إسلامية هندسية
    */

    background-image:

    radial-gradient(
        circle at center,
        rgba(212,168,64,0.10) 2px,
        transparent 2px
    ),

    linear-gradient(
        45deg,
        transparent 46%,
        rgba(212,168,64,0.08) 47%,
        rgba(212,168,64,0.08) 53%,
        transparent 54%
    ),

    linear-gradient(
        -45deg,
        transparent 46%,
        rgba(212,168,64,0.08) 47%,
        rgba(212,168,64,0.08) 53%,
        transparent 54%
    ),

    radial-gradient(
        circle at 50% 0%,
        #126a49,
        #064d35 55%,
        #033b29 100%
    );

    background-size:
        28px 28px,
        56px 56px,
        56px 56px,
        100% 100%;

    background-attachment: fixed;

    min-height: 100vh;
}


/* إطار ذهبي خارجي */

body::before {

    content: "";

    position: fixed;

    inset: 10px;

    border: 2px solid rgba(218,175,68,0.55);

    border-radius: 25px;

    pointer-events: none;

    z-index: -1;
}


/* =========================
   الحاوية
========================= */

.container {

    max-width: 780px;

    margin: auto;

    padding: 25px 15px 40px;
}


/* =========================
   رأس الصفحة
========================= */

.header {

    position: relative;

    text-align: center;

    padding: 30px 20px 25px;

    margin-bottom: 18px;

    border-radius: 30px;

    background:
        linear-gradient(
            135deg,
            #07583c,
            #063f2d
        );

    border: 3px solid #d6ad45;

    box-shadow:
        0 8px 30px rgba(0,0,0,0.35),
        inset 0 0 30px rgba(218,175,68,0.08);

    overflow: hidden;
}


/* زخرفة داخل العنوان */

.header::before,
.header::after {

    content: "✦";

    position: absolute;

    top: 15px;

    color: #e0b84e;

    font-size: 35px;
}

.header::before {
    right: 25px;
}

.header::after {
    left: 25px;
}


.header h1 {

    margin: 0;

    color: #e4bd59;

    font-family: "Aref Ruqaa", serif;

    font-size: 42px;

    text-shadow:
        0 2px 5px rgba(0,0,0,0.5);
}


.reciter {

    margin-top: 5px;

    color: #f3df9a;

    font-size: 18px;
}


/* =========================
   الدعاء
========================= */

.dua {

    position: relative;

    background:
        linear-gradient(
            135deg,
            #fffdf2,
            #f5efd7
        );

    border: 3px solid #d6ad45;

    border-radius: 25px;

    padding: 25px 18px;

    margin-bottom: 20px;

    box-shadow:
        0 8px 25px rgba(0,0,0,0.25),
        inset 0 0 25px rgba(190,150,50,0.08);

    text-align: center;

    font-family: "Aref Ruqaa", serif;

    font-size: 26px;

    line-height: 1.9;

    color: #176342;
}


.dua::before {

    content: "❖";

    display: block;

    color: #c69b34;

    font-size: 25px;

    margin-bottom: 5px;
}


.dua::after {

    content: "❖";

    display: block;

    color: #c69b34;

    font-size: 25px;

    margin-top: 5px;
}


.dua p {

    margin: 2px 0;
}


/* =========================
   صندوق المشغل
========================= */

.player-box {

    background:
        linear-gradient(
            135deg,
            #fffdf3,
            #f2ecd6
        );

    border: 3px solid #d6ad45;

    border-radius: 25px;

    padding: 22px;

    box-shadow:
        0 8px 25px rgba(0,0,0,0.28);

    margin-bottom: 20px;
}


/* اسم السورة */

.current-surah {

    text-align: center;

    color: #176342;

    font-family: "Aref Ruqaa", serif;

    font-size: 34px;

    font-weight: bold;

    margin-bottom: 15px;
}


/* رقم السورة */

.current-surah::before {

    content: "۞ ";

    color: #c69b34;
}


/* =========================
   القائمة المنسدلة
========================= */

select {

    width: 100%;

    padding: 14px;

    border-radius: 12px;

    border: 2px solid #b88b28;

    background: #fffdf5;

    color: #174b35;

    font-family: "Cairo", sans-serif;

    font-size: 17px;

    margin-bottom: 18px;

    cursor: pointer;

    outline: none;
}


select:focus {

    border-color: #176342;

    box-shadow:
        0 0 0 3px rgba(214,173,69,0.2);
}


/* =========================
   مشغل الصوت
========================= */

audio {

    width: 100%;

    margin: 5px 0 18px;
}


/* =========================
   الأزرار
========================= */

.buttons {

    display: flex;

    gap: 12px;

    margin-top: 5px;
}


button {

    flex: 1;

    padding: 14px 10px;

    border: 2px solid #d6ad45;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #086044,
            #06432f
        );

    color: #fff5cf;

    font-family: "Cairo", sans-serif;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;

    transition: 0.2s;
}


button:hover {

    transform: translateY(-2px);

    background:
        linear-gradient(
            135deg,
            #0b7653,
            #075038
        );

    box-shadow:
        0 5px 15px rgba(0,0,0,0.2);
}


button:active {

    transform: translateY(0);
}


button:disabled {

    opacity: 0.5;

    cursor: not-allowed;
}


/* =========================
   عنوان قائمة السور
========================= */

.list-title {

    text-align: center;

    color: #f4d77c;

    font-family: "Aref Ruqaa", serif;

    font-size: 31px;

    margin: 25px 0 12px;

    text-shadow:
        0 2px 4px rgba(0,0,0,0.5);
}


.list-title::before {

    content: "❖  ";
}

.list-title::after {

    content: "  ❖";
}


/* =========================
   قائمة السور
========================= */

.surah-list {

    background:
        linear-gradient(
            135deg,
            #fffdf3,
            #f1ead2
        );

    border: 3px solid #d6ad45;

    border-radius: 20px;

    overflow: hidden;

    max-height: 570px;

    overflow-y: auto;

    box-shadow:
        0 8px 25px rgba(0,0,0,0.3);
}


/* شريط التمرير */

.surah-list::-webkit-scrollbar {

    width: 9px;
}

.surah-list::-webkit-scrollbar-track {

    background: #e5ddc3;

    border-radius: 10px;
}

.surah-list::-webkit-scrollbar-thumb {

    background: #b88b28;

    border-radius: 10px;
}


/* السورة */

.surah-item {

    padding: 14px 18px;

    border-bottom: 1px solid #ddd2b2;

    font-size: 17px;

    cursor: pointer;

    transition: 0.2s;

    color: #174b35;
}


.surah-item:hover {

    background: #e8f2e8;

    color: #07583c;
}


.surah-item.active {

    background:
        linear-gradient(
            90deg,
            #07583c,
            #0a6b49
        );

    color: #fff4c7;

    font-weight: bold;

    border-right: 5px solid #d6ad45;
}


.number {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 38px;

    height: 30px;

    margin-left: 7px;

    border-radius: 50%;

    background: #e6e0c8;

    color: #176342;

    font-weight: bold;
}


.active .number {

    background: #d6ad45;

    color: #16462f;
}


/* =========================
   الفوتر
========================= */

.footer {

    text-align: center;

    margin-top: 25px;

    color: #f0d477;

    font-family: "Aref Ruqaa", serif;

    font-size: 20px;

    text-shadow:
        0 2px 4px rgba(0,0,0,0.5);
}


/* =========================
   الجوال
========================= */

@media (max-width: 600px) {

    .container {

        padding: 15px 10px 30px;
    }

    .header {

        padding: 25px 12px;
    }

    .header h1 {

        font-size: 34px;
    }

    .dua {

        font-size: 22px;

        padding: 20px 12px;
    }

    .current-surah {

        font-size: 29px;
    }

    .buttons {

        gap: 8px;
    }

    button {

        font-size: 14px;

        padding: 13px 5px;
    }

}

</style>

</head>


<body>


<div class="container">


<!-- =========================
     العنوان
========================= -->

<div class="header">

<h1>
القرآن الكريم
</h1>

<div class="reciter">
بصوت الشيخ سعود الشريم
</div>

</div>


<!-- =========================
     الدعاء
========================= -->

<div class="dua">

<p>
اللهم اجعل هذا العمل خالصًا لك وحدك
</p>

<p>
اللهم إني عملت هذا العمل صدقةً لوجه الله
</p>

<p>
عني وعن والدي وكل من لهم حق علي
</p>

<p>
والمسلمين والمسلمات الأحياء منهم والأموات
</p>

</div>


<!-- =========================
     المشغل
========================= -->

<div class="player-box">


<div
class="current-surah"
id="currentSurah">

الفاتحة

</div>


<select id="surahSelect"></select>


<audio
id="audioPlayer"
controls
preload="none">

متصفحك لا يدعم تشغيل الصوت.

</audio>


<div class="buttons">

<button id="prevBtn">
◀ السورة السابقة
</button>

<button id="nextBtn">
السورة التالية ▶
</button>

</div>


</div>


<!-- =========================
     قائمة السور
========================= -->

<div class="list-title">
اختر السورة
</div>


<div
class="surah-list"
id="surahList">
</div>


<div class="footer">

اللهم تقبل هذا العمل واجعله صدقة جارية

</div>


</div>


<script>


/* =========================
   أسماء السور
========================= */

const surahs = [

"الفاتحة",
"البقرة",
"آل عمران",
"النساء",
"المائدة",
"الأنعام",
"الأعراف",
"الأنفال",
"التوبة",
"يونس",
"هود",
"يوسف",
"الرعد",
"إبراهيم",
"الحجر",
"النحل",
"الإسراء",
"الكهف",
"مريم",
"طه",
"الأنبياء",
"الحج",
"المؤمنون",
"النور",
"الفرقان",
"الشعراء",
"النمل",
"القصص",
"العنكبوت",
"الروم",
"لقمان",
"السجدة",
"الأحزاب",
"سبأ",
"فاطر",
"يس",
"الصافات",
"ص",
"الزمر",
"غافر",
"فصلت",
"الشورى",
"الزخرف",
"الدخان",
"الجاثية",
"الأحقاف",
"محمد",
"الفتح",
"الحجرات",
"ق",
"الذاريات",
"الطور",
"النجم",
"القمر",
"الرحمن",
"الواقعة",
"الحديد",
"المجادلة",
"الحشر",
"الممتحنة",
"الصف",
"الجمعة",
"المنافقون",
"التغابن",
"الطلاق",
"التحريم",
"الملك",
"القلم",
"الحاقة",
"المعارج",
"نوح",
"الجن",
"المزمل",
"المدثر",
"القيامة",
"الإنسان",
"المرسلات",
"النبأ",
"النازعات",
"عبس",
"التكوير",
"الانفطار",
"المطففين",
"الانشقاق",
"البروج",
"الطارق",
"الأعلى",
"الغاشية",
"الفجر",
"البلد",
"الشمس",
"الليل",
"الضحى",
"الشرح",
"التين",
"العلق",
"القدر",
"البينة",
"الزلزلة",
"العاديات",
"القارعة",
"التكاثر",
"العصر",
"الهمزة",
"الفيل",
"قريش",
"الماعون",
"الكوثر",
"الكافرون",
"النصر",
"المسد",
"الإخلاص",
"الفلق",
"الناس"

];


/* =========================
   العناصر
========================= */

const select =
document.getElementById("surahSelect");

const list =
document.getElementById("surahList");

const audio =
document.getElementById("audioPlayer");

const currentSurah =
document.getElementById("currentSurah");

const prevBtn =
document.getElementById("prevBtn");

const nextBtn =
document.getElementById("nextBtn");


let currentIndex = 0;


/* =========================
   إنشاء القائمة المنسدلة
========================= */

surahs.forEach(function(name, index) {

    const option =
    document.createElement("option");

    option.value = index;

    option.textContent =
    (index + 1) + " - " + name;

    select.appendChild(option);

});


/* =========================
   إنشاء قائمة السور
========================= */

surahs.forEach(function(name, index) {

    const item =
    document.createElement("div");

    item.className =
    "surah-item";

    item.innerHTML =
    '<span class="number">' +
    (index + 1) +
    '</span>' +
    name;

    item.addEventListener(
        "click",
        function() {

            currentIndex = index;

            loadSurah(true);

        }
    );

    list.appendChild(item);

});


/* =========================
   تحميل السورة
========================= */

function loadSurah(autoPlay) {

    const number =
    String(currentIndex + 1)
    .padStart(3, "0");


    const audioUrl =
    "https://server7.mp3quran.net/shur/" +
    number +
    ".mp3";


    audio.src = audioUrl;

    audio.load();


    currentSurah.textContent =
    (currentIndex + 1) +
    " - " +
    surahs[currentIndex];


    select.value = currentIndex;


    updateActive();


    if (autoPlay) {

        const playPromise =
        audio.play();

        if (playPromise !== undefined) {

            playPromise.catch(function() {

                console.log(
                    "اضغط تشغيل من مشغل الصوت."
                );

            });

        }

    }

}


/* =========================
   تحديث السورة النشطة
========================= */

function updateActive() {

    const items =
    document.querySelectorAll(
        ".surah-item"
    );


    items.forEach(function(item, index) {

        item.classList.remove("active");


        if (index === currentIndex) {

            item.classList.add("active");

            item.scrollIntoView({

                behavior: "smooth",

                block: "center"

            });

        }

    });

}


/* =========================
   القائمة المنسدلة
========================= */

select.addEventListener(
    "change",
    function() {

        currentIndex =
        parseInt(this.value);

        loadSurah(true);

    }
);


/* =========================
   السابقة
========================= */

prevBtn.addEventListener(
    "click",
    function() {

        if (currentIndex > 0) {

            currentIndex--;

            loadSurah(true);

        }

    }
);


/* =========================
   التالية
========================= */

nextBtn.addEventListener(
    "click",
    function() {

        if (
            currentIndex <
            surahs.length - 1
        ) {

            currentIndex++;

            loadSurah(true);

        }

    }
);


/* =========================
   بعد انتهاء السورة
========================= */

audio.addEventListener(
    "ended",
    function() {

        if (
            currentIndex <
            surahs.length - 1
        ) {

            currentIndex++;

            loadSurah(true);

        }

    }
);


/* =========================
   بداية الصفحة
========================= */

loadSurah(false);


</script>


</body>

</html>